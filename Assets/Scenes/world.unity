    pointsReward: 5
    cutscene: {fileID: 0}
    questTeleport: {fileID: 0}
    startSequence: []
    completionSequence:
    - speaker: 0
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - ... WHat is that??
      triggerDistortion: 0
    - speaker: 1
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - This is the dungeon gate.
      triggerDistortion: 0
    - speaker: 0
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - gate? but it leads to nowhere.
      triggerDistortion: 0
    - speaker: 1
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - its a rift portal. entring the rift will teleport you to the dungeon. thats
        where our first commision is.
      - All we need to do is kill some monsters and we will be done.
      triggerDistortion: 0
    - speaker: 0
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - kill monsters?
      - can't i just stay here and wait for you?
      triggerDistortion: 0
    - speaker: 1
      npcName: Skye
      npcPortrait: {fileID: 21300000, guid: 7dd544c963961fc47b5d47d174ba9bef, type: 3}
      lines:
      - Stay here? with the rift monsters wandering the forest. the safest option
        you have is me.
      - you will be free dinner to the monsters here.
      - head inside, ill folow after you.
      triggerDistortion: 0
    showChoiceScreen: 0
    choicePrompt: Head out?
    choiceLabelA: Head Out
    choiceLabelB: Stay and Explore
    choiceTeleport: {fileID: 1533161311}
