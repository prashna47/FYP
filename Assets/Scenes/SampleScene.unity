  textScreens:
  - text: It was a perfect day..
    startDelay: 2
    fadeInTime: 0.7
    stayTime: 1
    fadeOutTime: 1
  - text: "Mom laughed as she teased Dad, pretending he couldn\u2019t drive."
    startDelay: 6
    fadeInTime: 0.7
    stayTime: 2
    fadeOutTime: 1
  - text: Dad always played along, smiling at her jokes.
    startDelay: 8.5
    fadeInTime: 0.7
    stayTime: 1
    fadeOutTime: 1
  - text: '"Dad! Look at what i made !"'
    startDelay: 6
    fadeInTime: 0.7
    stayTime: 0.8
    fadeOutTime: 2
  - text: "If I hadn\u2019t made him look\u2026"
