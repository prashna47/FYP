  textScreens:
  - text: I know this place..
    startDelay: 6.5
    fadeInTime: 0.7
    stayTime: 1
    fadeOutTime: 1
  - text: I used to sit here while he played
    startDelay: 5.8
    fadeInTime: 0.7
    stayTime: 0.9
    fadeOutTime: 1
  - text: That was before things changed..
    startDelay: 6.3
    fadeInTime: 0.7
    stayTime: 0.8
    fadeOutTime: 1
  - text: Now i just sit... alone
    startDelay: 2.5
    fadeInTime: 0.7
    stayTime: 0.8
